{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": [
      "node"
    ],
    "paths": {
      "@ulde/core": [
        "/src/ulde/core/index"
      ],
      "@ulde/core/*": [
        "/src/ulde/core/*"
      ],
      "@ulde/engine": [
        "./src/ulde/engine/index"
      ],
      "@ulde/engine/*": [
        "./src/ulde/engine/*"
      ],
      "@ulde/plugins": [
        "./src/ulde/plugins/index"
      ],
      "@ulde/plugins/*": [
        "./src/ulde/plugins/*"
      ],
      "@ulde/tools": [
        "./src/ulde/tools/index"
      ],
      "@ulde/tools/*": [
        "./src/ulde/tools/*"
      ],
      "@ulde/types": [
        "./src/ulde/types/index"
      ],
      "@ulde/types/*": [
        "./src/ulde/types/*"
      ],
      "@ulde/viewer": [
        "./src/ulde/viewer/index"
      ],
      "@ulde/viewer/*": [
        "./src/ulde/viewer/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    // workspave-level config files need to be excluded because VSCODE tries to type-check everything in the workspace
    "vite.config.ts"
  ]
}
