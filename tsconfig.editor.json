// VS Code intellisense
/*
Must match TS7
✔ Must not include workspace files
✔ Must not include Vite config
*/
{
  "extends": "./tsconfig",
  "compilerOptions": {
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    // workspave-level config files need to be excluded because VSCODE tries to type-check everything in the workspace
    "vite.config.ts"
  ]
}
