// tsconfig.spec.json
/* unit tests
✔ Should NOT include ULDE aliases
✔ Should NOT include Vite config
✔ Should NOT include workspace files
*/

{
  "extends": "./tsconfig",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    "types": [
      "vitest/globals"
    ]
  },
  "include": [
    "src/**/*.d.ts",
    "src/**/*.spec.ts"
  ],

  "exclude": [
    "vite.config.ts"
  ]
}
