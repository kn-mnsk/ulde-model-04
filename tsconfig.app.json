/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "./tsconfig",
  "compilerOptions": {
    "outDir": "./out-tsc/app", // TS-safe
    "types": [
      "node"
    ] // TS-safe
  },
  "include": [
    "src/**/*.ts",
    "src/ulde/types/*.d.ts" // resolve ULDE aliases
  ],
  "exclude": [
    "src/**/*.spec.ts",
    "vite.config.ts"
  ]
}
